{
  "expo": {
    "name": "BorlaManApp",
    "slug": "BorlaManApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.borlaman.app"
    },
    "android": {
      "package": "com.borlaman.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BorlaMan uses your location to set your pickup point and match you with nearby collectors."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BorlaMan needs photo access so you can attach pictures of your waste to a pickup request.",
          "cameraPermission": "BorlaMan uses the camera so you can photograph your waste for a pickup request."
        }
      ]
    ]
  }
}
