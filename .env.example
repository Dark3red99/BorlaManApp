# Copy to .env.local and fill in. EXPO_PUBLIC_* values are inlined into the
# client bundle at build time — restrict keys by app ID in the provider dashboard.

# MapTiler: tiles (style.json) + geocoding. https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_KEY=

# Supabase: Project Settings → API Keys. Use the publishable key (sb_publishable_…),
# never the secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
