{
  "name": "borlaman",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm run start --workspace @borlaman/customer",
    "rider": "npm run start --workspace @borlaman/rider",
    "customer:web": "npm run web --workspace @borlaman/customer",
    "rider:web": "npm run web --workspace @borlaman/rider",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
